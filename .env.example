# Root .env for running the notebooks (module-0 to module-6).
# Copy this file to .env and fill in your own keys.
# The `studio/` subfolder inside each module has its own .env.example
# used by `langgraph dev` - copy those too if you plan to use Studio.

# Get a free key at https://openrouter.ai/keys
OPENAI_API_KEY=sk-or-v1-xxx
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Default model used across all notebooks. Change here to switch models everywhere.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Used as a manual fallback if OPENROUTER_MODEL has issues with tool calling / availability.
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Required for Module 4 (web search notebooks and the research-assistant final project).
TAVILY_API_KEY=tvly-xxxx

# Optional, recommended for tracing/debugging with LangSmith.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langchain-academy-openrouter
